rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is whitelisted admin
    function isAdmin() {
      return request.auth != null && 
        request.auth.token.email != null &&
        (request.auth.token.email.lower() in [
          'kwancanoe@gmail.com',
          'aon.garmin@gmail.com',
          'thaitravel@gmail.com'
        ]);
    }

    // Preorder rounds: Public can read, only admin can manage
    match /rounds/{roundId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products catalog: Public can read, only admin can manage
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders:
    // - Customers can create orders and look up order details
    // - Admins can read all orders, update status, weigh fruits, or cancel
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }
  }
}
